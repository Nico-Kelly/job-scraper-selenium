{
    "target_portal": "linkedin",
    "export_method": "csv",
    "csv_filename": "scraped_jobs.csv",
    "max_pages":3,
    "driver_config": {
        "browser": "chrome",
        "headless_mode": false
    },
    "urls": {
        "linkedin": "https://www.linkedin.com/jobs/search/",
        "computrabajo": "https://ar.computrabajo.com/"
    },
    "timeouts": {
        "explicit_wait": 10
    },
    "search_params": {
        "job_title": "QA Automation",
        "location": "Pilar, Buenos Aires"
    }
}